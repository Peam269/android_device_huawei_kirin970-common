# Android fstab file.
#<src>                                                  <mnt_point>         <type>    <mnt_flags and options>                                                             <fs_mgr_flags>
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
system                                                  /system             ext4      ro,barrier=1                                                                        wait,logical,first_stage_mount
product                                                 /product            ext4      ro,errors=panic                                                                     wait,logical,first_stage_mount
vendor                                                  /vendor             ext4      ro,barrier=1                                                                        wait,logical,first_stage_mount
odm                                                     /odm                ext4      ro,errors=panic                                                                     wait,logical,first_stage_mount
system_ext                                              /system_ext         ext4      ro,barrier=1                                                                        wait,logical,first_stage_mount

/dev/block/by-name/kernel                               /boot               emmc      defaults                                                                            defaults
/dev/block/by-name/recovery_ramdisk                     /recovery           emmc      defaults                                                                            defaults
/dev/block/by-name/splash2                              /splash2            ext4      rw,nosuid,nodev,noatime,data=ordered,context=u:object_r:splashtwo_file:s0           wait,nofail
/dev/block/by-name/userdata                             /data               f2fs      nosuid,nodev,noatime,discard,inline_data,inline_xattr                               latemount,wait,check,fileencryption=aes-256-xts:aes-256-cts,reservedsize=20M,quota
/dev/block/by-name/cache                                /cache              ext4      rw,nosuid,nodev,noatime,data=ordered                                                wait,check,nofail
/dev/block/by-name/hisee_fs                             /mnt/hisee_fs       ext4      ro,barrier=1,context=u:object_r:hisee_file:s0                                       wait,check,notrim,nofail
/dev/block/by-name/patch                                /metadata           ext4      rw,nosuid,nodev,noatime,data=ordered                                                wait,first_stage_mount,formattable,check
/dev/block/by-name/misc                                 /misc               emmc      defaults                                                                            defaults
/dev/block/by-name/oeminfo                              /oeminfo            emmc      defaults                                                                            defaults,first_stage_mount

/devices/hi_mci.1/mmc_host/mmc1/*                       auto                auto      defaults                                                                            voldmanaged=sdcard:auto,noemulatedsd,encryptable=userdata
/devices/platform/hi_mci.1/mmc_host/mmc1/*              auto                auto      defaults                                                                            voldmanaged=sdcard:auto,noemulatedsd,encryptable=userdata
/devices/hisi_usb@ff200000/ff100000.dwc3/*              auto                auto      defaults                                                                            voldmanaged=usbotg:auto
/devices/platform/hisi_usb@ff200000/ff100000.dwc3/*     auto                auto      defaults                                                                            voldmanaged=usbotg:auto
/devices/platform/e7f00000.hifi_usb/*                   auto                auto      defaults                                                                            voldmanaged=usbotg:auto

/dev/block/zram0                                        none                swap      defaults                                                                            zramsize=50%,max_comp_streams=8,zram_backingdev_size=512M
